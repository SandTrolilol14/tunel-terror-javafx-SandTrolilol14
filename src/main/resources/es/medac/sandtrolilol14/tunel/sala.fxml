<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="raiz"
           prefHeight="720.0"
           prefWidth="1280.0"
           styleClass="raiz"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="es.medac.sandtrolilol14.tunel.SalaController">

    <!-- Panel principal de la radio -->
    <VBox fx:id="panelRadio"
          alignment="CENTER"
          maxHeight="620.0"
          maxWidth="850.0"
          spacing="18.0"
          styleClass="radio">
        <padding>
            <Insets bottom="35.0" left="40.0" right="40.0" top="35.0" />
        </padding>

        <!-- Encabezado / Título de la emisora -->
        <Label fx:id="lblTitulo"
               alignment="CENTER"
               styleClass="titulo"
               text="ECHOES OF THE VOID - 1984"
               textAlignment="CENTER" />

        <!-- Rejilla decorativa del altavoz antiguo -->
        <VBox alignment="CENTER"
              spacing="6.0"
              styleClass="altavoz">
            <VBox.margin>
                <Insets bottom="5.0" top="5.0" />
            </VBox.margin>
            <Region prefHeight="4" styleClass="decoracion" />
            <Region prefHeight="4" styleClass="decoracion" />
            <Region prefHeight="4" styleClass="decoracion" />
            <Region prefHeight="4" styleClass="decoracion" />
        </VBox>

        <!-- Instrucción del juego -->
        <Label fx:id="lblInstruccion"
               alignment="CENTER"
               styleClass="instruccion"
               text="Gira el dial. Encuentra la frecuencia. Escúchala."
               textAlignment="CENTER" />

        <!-- Contenedor del dial y la frecuencia -->
        <VBox alignment="CENTER"
              spacing="12.0"
              styleClass="decoracion">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <Label fx:id="lblFrecuencia"
                   alignment="CENTER"
                   styleClass="frecuencia"
                   text="--.- MHz" />

            <Slider fx:id="sldDial"
                    maxWidth="650.0"
                    prefWidth="600.0"
                    showTickLabels="false"
                    showTickMarks="false"
                    styleClass="dial" />
        </VBox>

        <!-- Indicador de barra de señal -->
        <ProgressBar fx:id="pbSenal"
                     maxWidth="650.0"
                     prefHeight="22.0"
                     prefWidth="600.0"
                     progress="0.0"
                     styleClass="senal" />

        <!-- Mensaje dinámico de ayuda -->
        <Label fx:id="lblAyuda"
               alignment="CENTER"
               maxWidth="700.0"
               styleClass="ayuda"
               text="La señal parece resistirse al sentido común..."
               visible="false"
               wrapText="true" />

        <!-- Botones decorativos inferiores analógicos -->
        <HBox alignment="CENTER"
              spacing="40.0"
              styleClass="decoracion">
            <Region prefHeight="20" prefWidth="20" styleClass="decoracion" />
            <Region prefHeight="20" prefWidth="20" styleClass="decoracion" />
            <Region prefHeight="20" prefWidth="20" styleClass="decoracion" />
        </HBox>
    </VBox>

    <!-- Elementos superpuestos (Susto y Letra) -->
    <Label fx:id="lblLetra"
           alignment="CENTER"
           mouseTransparent="true"
           styleClass="letra"
           text="I"
           visible="false"
           StackPane.alignment="CENTER" />

    <ImageView fx:id="imgSusto"
               fitHeight="600.0"
               mouseTransparent="true"
               preserveRatio="true"
               visible="false"
               StackPane.alignment="CENTER">
        <image>
            <Image url="@img/susto.png" />
        </image>
    </ImageView>

</StackPane>